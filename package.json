{
  "name": "openbeehive-docs",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "tools": "go install github.com/fleetlint/fleetlint/cmd/fleetlint@v0.5.1 && go install github.com/zricethezav/gitleaks/v8@v8.30.1",
    "fmt": "prettier --write . && eslint --fix .",
    "lint": "prettier --check . && eslint --max-warnings=0 . && tsc --noEmit",
    "test": "docusaurus build",
    "cover": "echo \"no coverage gate: the site has no unit-tested code; test builds every page of every version and locale\"",
    "audit": "audit-ci --config audit-ci.jsonc && license-checker-rseidelsohn --production --excludePrivatePackages --summary --onlyAllow \"MIT;MIT-0;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;BlueOak-1.0.0;MPL-2.0;Python-2.0;CC-BY-4.0;Unlicense\" && knip --dependencies && gitleaks git --no-banner --redact .",
    "check-fast": "npm run lint",
    "check": "npm run lint && npm run test && npm run audit && fleetlint check --fail-on error"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/js": "10.0.1",
    "@types/react": "^19.0.0",
    "audit-ci": "7.1.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "knip": "6.41.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "uuid": "^14.0.0",
    "qs": "^6.16.0",
    "tinypool": "^2.2.0"
  }
}
